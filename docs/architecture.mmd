%% ---------------------------------------------------------------------
%% (b) HTTP MIDDLEWARE PIPELINE — backend/src/server.ts :: buildServer()
%% Order matters. Every request flows left to right before reaching a route.
%% ---------------------------------------------------------------------
flowchart LR
    Req(["Incoming request"]) --> RID["1. requestId hook<br/>backend/src/requestId.ts<br/>x-request-id / x-trace-id"]
    RID --> Helmet["2. @fastify/helmet<br/>security headers"]
    Helmet --> Cookie["3. @fastify/cookie<br/>session cookie parsing"]
    Cookie --> CORS["4. @fastify/cors<br/>explicit origin list<br/>CORS_ORIGIN, credentials"]
    CORS --> MP["5. @fastify/multipart<br/>1 file, ≤ MAX_UPLOAD_BYTES"]
    MP --> RL["6. @fastify/rate-limit<br/>300/min, keyed by<br/>sha256(session token) or IP"]
    RL --> GC["7. Global ceiling hook<br/>3000 req/min per instance<br/>[CURRENT] in-memory;<br/>[FUTURE] shared limiter<br/>for multi-instance"]
    GC --> Router["8. Router — /api/v1<br/>health, auth, audit, models,<br/>conversations, chat,<br/>documents, tools"]
    Router --> Handler["Route handler<br/>preHandler: requireAuth<br/>+ requirePermission(...)"]
    Handler --> ErrH["9. serverErrorHandler<br/>AppError → its status<br/>validation → 400<br/>429 / 413 honored<br/>else generic 500<br/>never leaks internals"]
    ErrH --> Resp(["Response"])
    Router -.->|"onResponse hook"| Log["Structured access log<br/>requestId, traceId,<br/>tenantId, userId,<br/>route, status, latencyMs"]

%% ---------------------------------------------------------------------
%% (c) AUTH / SESSION FLOW
%% Sessions are server-side; the JWT is short-lived (15m). Refresh tokens are
%% opaque, stored hashed, and rotated with reuse detection.
%% ---------------------------------------------------------------------
sequenceDiagram
    autonumber
    participant C as React SPA
    participant R as POST /api/v1/auth/login<br/>backend/src/auth/routes.ts
    participant A as auth/* (password.ts<br/>argon2 verify)
    participant S as sessions table<br/>003_enterprise_platform.sql
    participant F as POST /api/v1/auth/refresh<br/>rotateRefreshToken()

    C->>R: email + password
    R->>A: verify credentials
    A-->>R: ok (constant-time)
    R->>S: INSERT session<br/>(refresh_token_hash, expires_at,<br/>ip, user_agent)
    R-->>C: 15m access JWT (httpOnly cookie)<br/>+ opaque refresh token
    Note over C,F: Later — access token expired
    C->>F: refresh token
    F->>S: lookup by hash
    alt hash in previous_refresh_token_hashes (GIN @>)
        F->>S: REUSE DETECTED — revoke all<br/>sessions for user
        F-->>C: 401 (typed InvalidRefreshSessionError)
    else valid current hash
        F->>S: rotate: new hash current,<br/>old hash → previous_refresh_token_hashes
        F-->>C: new JWT + new refresh token
    end
    Note over C,F: AbortError / signing errors are never<br/>misclassified as reuse (no mass revoke).

%% ---------------------------------------------------------------------
%% (d) CHAT SSE FLOW + AGENTIC TOOL LOOP — backend/src/chat/routes.ts
%% The model's output, retrieved chunks, and tool results are all UNTRUSTED
%% and are delimited/escaped before entering the next prompt or the client.
%% ---------------------------------------------------------------------
sequenceDiagram
    autonumber
    participant C as React SPA (fetch streaming)
    participant H as POST /api/v1/chat<br/>chat/routes.ts
    participant Z as authz (requireAuth<br/>+ chat:create + clearance)
    participant W as applyContextWindow<br/>gateway.ts
    participant R as retrieveAuthorizedContext()<br/>rag/retrieval.ts
    participant G as gatewayStream()<br/>ai/gateway/gateway.ts
    participant CR as capabilityRouter<br/>resolveCapabilityModel
    participant MR as modelRegistry<br/>getApprovedModelForUser
    participant V as vllmProvider<br/>OpenAI-compatible /chat/completions
    participant T as runToolCall()<br/>tools/gateway.ts
    participant DB as PostgreSQL
    participant AU as recordAudit()

    C->>H: { conversationId?, content ≤32k,<br/>modelId?, classification?, documentIds?,<br/>capability?, codeFiles?[] }
    Note over C,H: fetch() POST, accept: text/event-stream.<br/>Client reads the streaming response body<br/>and parses SSE frames manually<br/>(frontend/src/api.ts :: streamChat).<br/>Not native EventSource (GET-only).<br/>401 → refresh → single retry.
    H->>Z: authenticate → authorize →<br/>assertClassificationAllowed
    H->>DB: load conversation, verify ownership<br/>+ tenant scope
    H->>DB: load history
    H->>W: truncate oldest turns to model.context_window<br/>(dropped count surfaced, never silent)
    H->>R: tenant-isolated hybrid retrieval<br/>(see diagram f) → citations
    H->>CR: resolveCapabilityModel()<br/>ai/gateway/capabilityRouter.ts<br/>detect/accept capability → serving default;<br/>stale capability model falls back to chat<br/>BEFORE streaming (audited once);<br/>explicit modelId wins
    H->>H: assemble codeFiles into labeled context<br/>(chat/codeContext.ts);<br/>enable codingMode when capability=coding
    H->>H: build system prompt;<br/>user input + RAG chunks delimited<br/>as untrusted (escapeUntrusted)
    H->>G: gatewayStream(messages, modelId)
    G->>MR: resolve approved model for user<br/>(id, endpoint, context_window,<br/>allowed_classifications)
    G->>G: check endpoint origin ∈<br/>AI_PROVIDER_ALLOWED_ORIGINS
    G->>G: canModelProcess(classification)
    G->>V: stream POST /chat/completions
    alt provider fails (not caller-cancelled)
        G->>V: failover to configured fallback model
        G-->>C: SSE notice MODEL_FAILOVER
    end
    G-->>C: SSE meta { conversationId, model,<br/>citations, contextDropped,<br/>capability, codeFiles }
    Note over H,V: Phase 6: the loop is a generalized engine<br/>(chat/agenticLoop.ts) — any tool family<br/>runs through the same budgets/audit/narration.<br/>H delegates rounds to runAgenticLoop().
    loop agentic loop (≤ AI_MAX_TOOL_ITERATIONS)
        V-->>C: SSE delta { content } chunks
        V-->>H: tool_calls proposed
        H->>H: TOOL_PLAN notice (one-line plan)
        H->>T: runToolCall(name, args)<br/>destructive tools NEVER auto-execute:<br/>approval gate → TOOL_REQUIRES_APPROVAL<br/>fed back to the model
        T->>T: registry lookup → zod schema<br/>validate → assert caller clearance<br/>→ Promise.race timeout
        T->>DB: INSERT tool_executions<br/>(audited)
        T-->>AU: TOOL_EXECUTED (sanitized reason;<br/>generic client-safe message)
        T-->>H: result (delimited as untrusted,<br/>size-capped)
        H->>AU: AGENTIC_LOOP_STEP (step, model,<br/>tools, argument KEYS only)
        H->>V: continue with tool result
    end
    alt iteration budget exhausted
        H-->>C: bracketed server notice in transcript<br/>(finishReason tool_budget) + AGENTIC_LOOP_BUDGET
    end
    V-->>C: SSE done { telemetry:<br/>tokens, latency, iterations }
    alt stream errored mid-way
        H->>H: markStreamInterrupted() →<br/>STREAM_INTERRUPTED_MARKER<br/>(P0-a: move to messages.metadata)
        H-->>C: SSE error { code, requestId }
    end
    H->>DB: persist user + assistant messages,<br/>citations, token counts
    H->>AU: CHAT_COMPLETED with<br/>GatewayTelemetry
    Note over C,H: Heartbeat ': ping' every 15s.<br/>Hijacked response tracked so<br/>shutdown can end it (P0-b: backpressure).

%% ---------------------------------------------------------------------
%% (e) DOCUMENT INGESTION PIPELINE — backend/src/documents/
%% Upload is synchronous through validation + enqueue; everything after the
%% queue is asynchronous. Job states: PENDING → PROCESSING →
%% SUCCEEDED | FAILED. Document status adds QUARANTINED.
%% Architectural boundary: the API owns request/authorization/enqueue;
%% long-running processing belongs in workers. The document_ingestion_jobs
%% table is the contract between them.
%% ---------------------------------------------------------------------
flowchart TB
    subgraph API["[CURRENT] Fastify API — owns upload, authz, enqueue"]
        direction TB
        UP(["POST /api/v1/documents<br/>multipart, 1 file"]) --> FV["fileValidation.ts<br/>allowlisted MIME ↔ extension,<br/>magic bytes, size ≤ MAX_UPLOAD_BYTES<br/>(client pre-checks 25 MB)"]
        FV -->|"invalid"| R400(["400, nothing stored"])
        FV -->|"valid"| CS["checksum sha256"]
        CS -->|"duplicate checksum"| R409(["409 CONFLICT"])
        CS --> CL["resolveUploadClassification()<br/>uploadClassification.ts<br/>requested label ∩ caller clearance"]
        CL --> INS["INSERT documents<br/>status='PENDING'<br/>documents/routes.ts"]
        INS --> PUT["S3 putObject<br/>storage.ts (MinIO dev)"]
        PUT --> SCAN["malware.ts<br/>MALWARE_SCAN_MODE=<br/>disabled-development | http"]
        SCAN -->|"threat"| QUAR["status='QUARANTINED'<br/>audit DOCUMENT_QUARANTINED"]
        SCAN -->|"clean"| ENQ["enqueueIngestion()<br/>INSERT document_ingestion_jobs<br/>status='PENDING'"]
    end

    JOBS[("document_ingestion_jobs<br/>[CURRENT] the contract:<br/>API enqueues → worker claims")]

    subgraph WORKER["[PARTIAL] in-process worker today (queue.ts)<br/>[FUTURE] dedicated worker replicas (P2-a)"]
        direction TB
        Q["claim: UPDATE … WHERE<br/>status='PENDING' → PROCESSING<br/>MAX_CONCURRENT_JOBS=2"] --> EXT["extraction.ts<br/>pdf / xlsx / docx / txt<br/>real local extractors<br/>page + sheet/row metadata"]
        EXT --> CH["chunking<br/>overlapping windows"]
        CH --> EMB["embeddings<br/>internalEmbeddingProvider<br/>provenance recorded"]
        EMB --> VEC[("INSERT document_chunks<br/>embedding vector(pgvector)<br/>tenant_id, document_id,<br/>classification")]
        VEC --> OK["jobs → SUCCEEDED<br/>documents → READY<br/>audit DOCUMENT_INGESTION_COMPLETED"]
        Q -->|"exception"| FAIL["jobs → FAILED<br/>(error_code, attempts)<br/>audit DOCUMENT_INGESTION_FAILED"]
    end

    RETRY["POST /documents/:id/retry<br/>owner-only, FAILED/QUARANTINED"]

    ENQ --> JOBS --> Q
    FAIL --> RETRY
    RETRY --> ENQ
    QUAR --> RETRY

%% ---------------------------------------------------------------------
%% (f) RAG RETRIEVAL PIPELINE — backend/src/rag/retrieval.ts
%% Authorization runs BEFORE scoring/threshold: the model can never see a
%% chunk the caller may not read. The reranker is untrusted by construction.
%% ---------------------------------------------------------------------
flowchart LR
    Q(["User query<br/>(≤8000 chars,<br/>DocumentsPanel search)"]) --> EMB["embed(query)<br/>same provider as<br/>ingestion (provenance)"]
    EMB --> VS[("pgvector HNSW<br/>filtered cosine search<br/>WHERE tenant_id = $1<br/>AND classification ≤ clearance<br/>AND (owner OR grant)<br/>ef_search=200")]
    VS --> CAND["authorized candidates<br/>{ chunkId, text, score }"]
    CAND --> HYB["hybrid score<br/>85% vector cosine<br/>+ 15% lexical overlap<br/>(terms ≥3 chars)"]
    HYB --> THR["similarity threshold<br/>ragThreshold tests"]
    THR --> RR{"reranker hook<br/>setReranker()"}
    RR -->|"default passthrough"| TOP["top-k"]
    RR -->|"external reranker"| VAL["validate: reorder only,<br/>scores clamped;<br/>rebuild every result from<br/>canonical candidate map<br/>by chunkId — reranker text/<br/>doc/citation fields discarded"]
    VAL --> TOP
    TOP --> CIT["citations[]<br/>{ documentId, documentName,<br/>chunkId, page?, section? }<br/>every citation grounded<br/>in the retrieved set"]
    CIT --> CTX["context string<br/>chunks escaped<br/>(escapeUntrusted)"]
    CTX --> PROMPT(["injected into chat<br/>system prompt as<br/>delimited untrusted<br/>context (diagram d)"])
    THR -->|"no candidates"| EMPTY(["no-context path:<br/>model answers without<br/>doc grounding — must not<br/>hallucinate citations"])

