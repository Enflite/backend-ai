    subgraph FAPI["[FUTURE] Flows REST API<br/>backend/src/flows/routes.ts<br/>FLOWS_ENABLED kill switch (default false)<br/>manage: flows:manage · runs: flows:run"]
        direction TB
        FCRUD["POST/GET/DELETE /flows[/:name]<br/>definition CRUD (schema-validated)"]
        FVER["POST /flows/:name/versions<br/>publish immutable version<br/>{ number, definitionHash,<br/>publishedBy, publishedAt }"]
        FALIAS["POST /flows/:name/alias<br/>move live alias<br/>If-Match: <revision> else 412"]
        FENS["POST /flows/ensure · GET /flows/:name/pull<br/>converge repo JSON ↔ registry"]
        FRUNS["POST /flows/:name/runs<br/>GET /flows/runs[/:runId]<br/>GET /runs/:runId/events (SSE)<br/>POST /runs/:runId/cancel<br/>Idempotency-Key · sync? · confirmWrites?"]
    end

