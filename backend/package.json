{
  "name": "backend-ai",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run copy:migrations",
    "copy:migrations": "rm -rf dist/src/db/migrations && cp -r src/db/migrations dist/src/db/migrations",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/src/db/migrate.js",
    "create-user": "tsx scripts/create-user.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "2.0.2",
    "cheerio": "^1.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "jose": "5.6.3",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "pg": "8.12.0",
    "yauzl": "^3.4.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/pg": "8.11.6",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.23.13",
    "typescript": "5.5.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
