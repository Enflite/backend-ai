# ============================================================================
# Enflite AI — START HERE (local development)
#
# Copy this file to backend/.env, fill the three secrets below, run:
#   cd backend && npm run dev
#
# That's the whole setup. Everything else in this file has a safe default —
# the reference below is opt-in. Defaults you'll rely on: PORT 8080,
# CORS_ORIGIN http://localhost:8443, CLAUDE_ENABLED true,
# ANTHROPIC_BASE_URL https://api.anthropic.com, and every authenticated user
# gets every permission (PERMISSIONS_ALL_GRANTED, see Access section below).
# ============================================================================
MONGODB_URI=mongodb://localhost:27017/enflite-ai
# At least 32 random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# Claude is the serving model. Without this, /models comes back empty and
# the UI sits on "Still loading the AI" forever.
ANTHROPIC_API_KEY=
# SyteLine UI automation (task agents drive the SyteLine web client).
SYTELINE_UI_ENABLED=true
SYTELINE_UI_URL=https://<syteline-web-client-host>/landing
# 64 hex chars for the per-user credential store. Generate: openssl rand -hex 32
CREDENTIAL_STORE_KEY=
# Server-side worker that claims assigned tasks and executes them.
SYTELINE_TASK_RUNNER_ENABLED=true
# Override the Claude chat model (default shown). Restarts apply the change —
# the stored provider-default seed is updated in place.
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ============================================================================
# COMPLETE REFERENCE — every config key, organized by section.
# Uncomment to override a default. Keys from START HERE are not repeated.
# A test (backend/test/envExample.test.ts) fails CI if config.ts gains a key
# that isn't documented here.
# ============================================================================

# --- Runtime ---
# NODE_ENV=development
# PORT=8080
# CORS_ORIGIN=http://localhost:8443

# --- Auth ---
# JWT_EXPIRES_IN=15m
# REFRESH_TOKEN_EXPIRES_DAYS=7
# COOKIE_SECURE=false
# All-grant posture: every authenticated user gets every permission, in code.
# Set to 'false' ONLY to restore DB-driven per-role granularity.
# PERMISSIONS_ALL_GRANTED=true
# AUDIT_FAIL_CLOSED=false

# --- Cloud providers (one-tap UI switcher) ---
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# CLAUDE_ENABLED=true
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ENABLED=true
# VLLM_API_KEY=
# Chat model IDs for the provider-default seeds. Restarts apply: a changed
# value updates the stored seed in place (identifier + name). ANTHROPIC_MODEL
# is documented in START HERE above.
# OPENAI_MODEL=gpt-4o

# --- Local Ollama stack (the "Enflite" provider) ---
# Off by default: the launch is Claude-only. Turn on when the local stack is ready.
# OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_EMBEDDING_DIMENSIONS=768
# OLLAMA_ALLOWED_MODELS=llama3.1:8b,nomic-embed-text,qwen2.5vl:7b
# Deprecated for inference; still gates local model artifact pulls (weight downloads).
# ALLOW_DEV_PROVIDERS=false

# --- Gateway limits ---
# AI_REQUEST_TIMEOUT_MS=120000
# PROMPT_CACHE_ENABLED=true
# AI_MAX_RESPONSE_CHARS=65536
# AI_MAX_TOOL_ITERATIONS=5
# AI_TOOL_OUTPUT_MAX_CHARS=8000
# AI_TOOL_TIMEOUT_MS=60000
# AI_MAX_CONCURRENT_PER_TENANT=20
# AI_MAX_CONCURRENT_PER_USER=5
# AI_MAX_CONCURRENT_TOOLS_PER_USER=10
# CHAT_RATE_LIMIT_PER_MIN=30
# TOOL_RATE_LIMIT_PER_MIN=120

# --- Embeddings ---
# Only needed when EMBEDDING_PROVIDER=openai-compatible:
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# EMBEDDING_MODEL_VERSION=1
# EMBEDDING_API_KEY=
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_TIMEOUT_MS=30000

# --- Model registry ---
# MODEL_SOURCE_ALLOWLIST=https://huggingface.co

# --- Object storage (S3-compatible, document bytes) ---
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_BUCKET=enflite-ai-documents
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# --- Uploads, extraction, vision ---
# MAX_UPLOAD_BYTES=26214400
# CHAT_MAX_IMAGES_PER_TURN=4
# CHAT_MAX_IMAGE_BYTES=8388608
# CHAT_MAX_IMAGE_TOTAL_BYTES=33554432
# MAX_EXTRACTED_CHARACTERS=2000000
# MAX_ARCHIVE_ENTRIES=1000
# MAX_ARCHIVE_UNCOMPRESSED_BYTES=52428800
# MAX_DOCUMENT_CHUNKS=2000
# EMBEDDING_BATCH_SIZE=32

# --- RAG ---
# RAG_TOP_K_MAX=20
# RAG_SIMILARITY_THRESHOLD=0
# RAG_DIVERSITY_LAMBDA=0.3
# RAG_QUERY_MAX_CHARS=2000
# RAG_CHUNK_MAX_CHARS=1600
# RAG_CHUNK_OVERLAP=200
# MAX_RAG_CONTEXT_CHARACTERS=24000

# --- Cross-encoder reranker (disabled by default) ---
# RERANKER_ENABLED=false
# RERANKER_URL=
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_TIMEOUT_MS=5000
# RERANKER_TOP_N=10

# --- Code indexing (repo.search / repo.readFile) ---
# REPO_WORKDIR=/data/repos
# REPO_GIT_HOST_ALLOWLIST=github.com
# REPO_LOCAL_ROOT=/data/repos-local
# GITHUB_TOKEN=
# GITHUB_ORG=Enflite
# GITHUB_API_BASE=https://api.github.com
# REPO_CHUNK_MAX_CHARS=6000
# REPO_CHUNK_OVERLAP=300
# REPO_MAX_FILE_BYTES=524288
# REPO_MAX_FILES=50000
# REPO_MAX_CHUNKS_PER_REPO=20000
# REPO_SEARCH_TOP_K_MAX=20

# --- Ingestion workers ---
# INGEST_WORKERS=4
# INGEST_MAX_ATTEMPTS=5
# INGEST_RETRY_BASE_DELAY_MS=30000
# INGEST_RETRY_MAX_DELAY_MS=900000

# --- Malware scanning ---
# MALWARE_SCANNER_ENDPOINT=
# MALWARE_SCAN_MODE=disabled-development

# --- SyteLine adapter (read-only tools) ---
# SYTELINE_BASE_URL=
# SYTELINE_API_TOKEN=
# SYTELINE_TIMEOUT_MS=15000
# SYTELINE_MAX_ROWS=100
# SYTELINE_FORM_PROJECTS_DIR=
# SYTELINE_FORM_TEMPLATES_DIR=

# --- SyteLine UI automation tuning ---
# SYTELINE_UI_USERNAME=
# SYTELINE_UI_PASSWORD=
# SYTELINE_UI_SESSION_IDLE_MS=300000
# SYTELINE_UI_SESSION_MAX_MS=1800000
# SYTELINE_UI_STEP_TIMEOUT_MS=30000
# SYTELINE_UI_EVIDENCE_DIR=./ui-evidence

# --- SyteLine task runner tuning ---
# SYTELINE_TASK_RUNNER_INTERVAL_MS=15000
# SYTELINE_TASK_RUNNER_TASK_TIMEOUT_MS=600000
# SYTELINE_TASK_RUNNER_SWEEP_LIMIT=10

# --- Flows platform (ADR-022) ---
# FLOWS_ENABLED=false
# FLOW_RUNNER_ENABLED=false
# FLOW_RUNNER_INTERVAL_MS=15000
# FLOW_STEP_TIMEOUT_MS=30000
# FLOW_SYNC_TIMEOUT_MS=60000
# FLOW_RUNNER_SWEEP_LIMIT=10

# --- Schedules platform (ADR-023) ---
# SCHEDULES_ENABLED=false
# SCHEDULE_SWEEP_INTERVAL_MS=30000
# SCHEDULE_SWEEP_LIMIT=20

# --- Form AI Agent product surface ---
# FORM_CUSTOMIZATION_API_ENABLED=false
# FORM_CUSTOMIZATION_RUNNER_ENABLED=false
# FORM_CUSTOMIZATION_GITHUB_ORG=Enflite
# FORM_CUSTOMIZATION_RUNNER_INTERVAL_MS=15000
# FORM_CUSTOMIZATION_RUNNER_TASK_TIMEOUT_MS=600000
# FORM_CUSTOMIZATION_RUNNER_SWEEP_LIMIT=5

# --- APS Planning Agent product surface ---
# APS_PLANNING_ENABLED=true

# --- Enterprise OIDC login ---
# OIDC_ENABLED=false
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
# OIDC_SCOPES=openid email profile
# OIDC_GROUP_CLAIM=groups
# OIDC_EMAIL_CLAIM=email
# OIDC_NAME_CLAIM=name
# OIDC_ROLE_MAPPING={}
# OIDC_DEFAULT_TENANT_ID=
# OIDC_DEFAULT_CLEARANCE=PUBLIC
# OIDC_FRONTEND_CALLBACK=

# --- DLP (assistant outbound boundary) ---
# DLP_ENABLED=true
# DLP_EXTERNAL_ENDPOINT=
# DLP_EXTERNAL_API_KEY=
# DLP_EXTERNAL_TIMEOUT_MS=2000

# --- Retention (days; 0/null = keep forever) ---
# RETENTION_CONVERSATIONS_DAYS=365
# RETENTION_MESSAGES_DAYS=365
# RETENTION_AUDIT_EVENTS_DAYS=730
# RETENTION_PURGE_INTERVAL_HOURS=24

# --- Observability ---
# METRICS_PUBLIC=
# READY_CHECK_TIMEOUT_MS=2000

# --- Dev auth bypass (never true in production) ---
# DEV_AUTH_ENABLED=false

# --- Fine-tuning flywheel (ADR-015) ---
# FINETUNE_PROVIDER=disabled
# FINETUNE_API_BASE_URL=
# FINETUNE_API_KEY=
# FINETUNE_ALLOWED_ORIGINS=
