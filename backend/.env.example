# Runtime
NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://localhost:27017/enflite-ai
CORS_ORIGIN=http://localhost:8443

# Authentication (replace with secret-manager values)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Enterprise OIDC login (Authorization Code + PKCE). Disabled unless
# OIDC_ENABLED=true; when enabled, all OIDC_* fields are required and the
# server refuses to boot without them.
# OIDC_ENABLED=true
# OIDC_ISSUER=https://login.example.com/realms/enflite
# OIDC_CLIENT_ID=enflite-backend
# OIDC_CLIENT_SECRET=<redacted>
# OIDC_REDIRECT_URI=https://app.example.com/api/v1/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# OIDC_GROUP_CLAIM=groups
# Claim names for the user's email and display name (OIDC standard defaults).
# OIDC_EMAIL_CLAIM=email
# OIDC_NAME_CLAIM=name
# JSON: IdP group -> internal role name. Unknown groups and mappings to
# nonexistent roles fail closed to the 'User' role.
# OIDC_ROLE_MAPPING={"sso-admins":"Admin"}
# Tenant that auto-provisioned SSO users join (uuid, required).
# OIDC_DEFAULT_TENANT_ID=
# Clearance for auto-provisioned SSO users (PUBLIC/INTERNAL/CONFIDENTIAL/PROPRIETARY/CUI).
# OIDC_DEFAULT_CLEARANCE=PUBLIC
# Frontend page that completes the login (tokens arrive in the URL fragment).
# OIDC_FRONTEND_CALLBACK=https://app.example.com/sso/callback

# DLP: assistant outbound boundary (SSN / Luhn-validated card redaction).
# DLP_ENABLED=true
# Optional external DLP sidecar: POST {text} -> {text}; best-effort, the
# built-in detectors are the enforced boundary.
# DLP_EXTERNAL_ENDPOINT=
# DLP_EXTERNAL_API_KEY=
# DLP_EXTERNAL_TIMEOUT_MS=2000

# Retention: per-tenant data retention (null/0 = keep forever).
# RETENTION_CONVERSATIONS_DAYS=365
# RETENTION_MESSAGES_DAYS=365
# RETENTION_AUDIT_EVENTS_DAYS=730
# RETENTION_PURGE_INTERVAL_HOURS=24
COOKIE_SECURE=false
DEV_AUTH_ENABLED=false

# Learning flywheel — fine-tuning provider toggle (ADR-015).
#   disabled (default): training endpoints fail closed; the kill switch.
#   external: submit jobs to a 3rd-party fine-tuning service (testing path).
#             Requires FINETUNE_API_BASE_URL + FINETUNE_API_KEY, and the base
#             URL's origin MUST be listed in FINETUNE_ALLOWED_ORIGINS.
#   local:    enqueue jobs for self-hosted GPU workers (finetune_jobs queue;
#             see backend/scripts/finetune-worker/). No credentials needed.
# FINETUNE_PROVIDER=disabled
# FINETUNE_API_BASE_URL=https://api.together.xyz
# FINETUNE_API_KEY=<redacted>
# FINETUNE_ALLOWED_ORIGINS=https://api.together.xyz

# Primary inference: Ollama (chat + embeddings), Windows-native.
# Native Windows host: run backend/scripts/setup-ollama-windows.ps1, then
# OLLAMA_BASE_URL=http://localhost:11434 (the default — nothing to set).
# Docker compose: OLLAMA_BASE_URL=http://ollama:11434 (the bundled service).
#
# OLLAMA_ENABLED gates the whole local stack: 'true'/'1'/'yes'
# (case-insensitive) turns it on; anything else (the default) runs the
# Claude-only launch — no Ollama chat/embeddings/vision models, no Ollama
# listings, no Enflite provider option, and no Ollama connection attempts.
# Image turns are served by the Claude vision model while the flag is off.
# Embedding/indexing operations fail with a clear OLLAMA_ENABLED message.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
# Exact allowlist for `ollama pull` via the admin API (no arbitrary models).
OLLAMA_ALLOWED_MODELS=llama3.1:8b,nomic-embed-text,qwen2.5vl:7b
# Deprecated for inference (no longer gates anything there); still the switch
# for local model artifact pulls (weight downloads via the admin API).
# ALLOW_DEV_PROVIDERS=false

# Cloud providers for the one-tap UI switcher (Enflite | Claude | OpenAI).
# The "Enflite" provider is local Ollama and needs no key. A cloud provider
# appears in the switcher only when its key is set (and not disabled).
# Keys are never logged, never returned by any API, never in errors.
# ANTHROPIC_API_KEY=<redacted>
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# CLAUDE_ENABLED=true
# OPENAI_API_KEY=<redacted>
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ENABLED=true

# High-throughput alternative: private vLLM (Linux; on Windows run it under
# WSL2/Docker). Model endpoints come from the model registry, not env.
VLLM_API_KEY=
AI_PROVIDER_ALLOWED_ORIGINS=http://localhost:8000,http://vllm:8000,http://localhost:11434,http://ollama:11434
AI_REQUEST_TIMEOUT_MS=120000
PROMPT_CACHE_ENABLED=true
AI_MAX_RESPONSE_CHARS=65536
AI_MAX_TOOL_ITERATIONS=5
AI_TOOL_OUTPUT_MAX_CHARS=8000

# Embeddings: Ollama by default (EMBEDDING_PROVIDER=ollama). The alternative
# is an OpenAI-compatible endpoint (EMBEDDING_PROVIDER=openai-compatible),
# e.g. vLLM /v1/embeddings.
#
# PINNED-DIMENSION WARNING: embedding model/version/dimensions are stored on
# every document_chunks row. Switching the embedding provider or model on an
# existing deployment INVALIDATES the index — re-ingest (re-embed) every
# document afterwards, or retrieval compares vectors from different spaces.
EMBEDDING_PROVIDER=ollama
# Only needed when EMBEDDING_PROVIDER=openai-compatible:
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_MODEL=internal-embedding-model
EMBEDDING_MODEL_VERSION=1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# S3-compatible private object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=enflite-ai-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=26214400
# Vision inputs: per-turn caps on attached chat images (count, per-image bytes, total bytes).
CHAT_MAX_IMAGES_PER_TURN=4
CHAT_MAX_IMAGE_BYTES=8388608
CHAT_MAX_IMAGE_TOTAL_BYTES=33554432
MAX_EXTRACTED_CHARACTERS=2000000
MAX_ARCHIVE_ENTRIES=1000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=52428800
MAX_DOCUMENT_CHUNKS=2000
EMBEDDING_BATCH_SIZE=32
RAG_TOP_K_MAX=20
MAX_RAG_CONTEXT_CHARACTERS=24000
# Minimum blended vector+lexical score for a chunk to enter model context.
# 0 disables the floor (default).
RAG_SIMILARITY_THRESHOLD=0

# Optional cross-encoder reranker (docs/rag.md, ADR-011). Disabled by default;
# the endpoint only ever receives the query text and already
# permission-filtered chunk texts. Its origin must be listed in
# AI_PROVIDER_ALLOWED_ORIGINS above.
RERANKER_ENABLED=false
RERANKER_URL=http://localhost:8000/rerank
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TIMEOUT_MS=5000
RERANKER_TOP_N=10

# Internal document security services
MALWARE_SCANNER_ENDPOINT=http://localhost:8091/scan
# disabled-development never reports a file clean and is forbidden in production.
MALWARE_SCAN_MODE=disabled-development

# Optional internal SyteLine adapter
SYTELINE_BASE_URL=https://syteline.internal.example
SYTELINE_API_TOKEN=
# Per-request timeout (ms) for SyteLine adapter calls; sits inside AI_TOOL_TIMEOUT_MS.
# SYTELINE_TIMEOUT_MS=15000
# Row cap for list fields in SyteLine results (order lines, POs, work orders,
# BOM components, inventory transactions); longer lists are truncated with a marker.
# SYTELINE_MAX_ROWS=100
# Root directory form-project working folders live under; every
# syteline.form_* project path is confined beneath it.
# SYTELINE_FORM_PROJECTS_DIR=./form-projects
# Absolute path to a checkout of Enflite/Form-Project-Templates (source for
# syteline.form_start_project); unset makes that tool fail fast.
# SYTELINE_FORM_TEMPLATES_DIR=

# SyteLine Form AI Agent product surface (/api/v1/form-customizations).
# TWO INDEPENDENT KILL SWITCHES, both default-off: the API gate and the
# server-side runner gate. Open PRs are never merged by automation.
# FORM_CUSTOMIZATION_API_ENABLED=true
# FORM_CUSTOMIZATION_RUNNER_ENABLED=true
# FORM_CUSTOMIZATION_GITHUB_ORG=Enflite

# Agentic SyteLine UI automation (syteline.ui.* tools). DISABLED BY DEFAULT:
# the master kill-switch; every UI tool fails fast while this is off/false.
# SYTELINE_UI_ENABLED=true
# https URL of the SyteLine web client (browser login landing page).
# SYTELINE_UI_URL=https://syteline.internal.example/web
# Tenant service-account fallback for browser login (used only when the
# requesting user has no stored credentials). Never logged.
# SYTELINE_UI_USERNAME=
# SYTELINE_UI_PASSWORD=<redacted>
# AES-256-GCM key for the per-user credential store: 32+ bytes as hex or
# base64. Generate with: openssl rand -hex 32. Documented placeholder values
# are rejected; credential features fail closed without a usable key.
# CREDENTIAL_STORE_KEY=<redacted>
# Browser session lifetime bounds (ms): idle TTL and absolute max duration.
# SYTELINE_UI_SESSION_IDLE_MS=300000
# SYTELINE_UI_SESSION_MAX_MS=1800000
# Per browser-driver step timeout (ms); sits inside AI_TOOL_TIMEOUT_MS.
# SYTELINE_UI_STEP_TIMEOUT_MS=30000
# Local root for tenant-scoped screenshot evidence (ids only reach the model).
# SYTELINE_UI_EVIDENCE_DIR=./ui-evidence
# SyteLine task-agent runner (DESIGN.md §11): server-side worker that claims
# assigned tasks and executes them as the requester. Disabled by default.
# SYTELINE_TASK_RUNNER_ENABLED=false
# SYTELINE_TASK_RUNNER_INTERVAL_MS=15000
# SYTELINE_TASK_RUNNER_TASK_TIMEOUT_MS=600000
# SYTELINE_TASK_RUNNER_SWEEP_LIMIT=10

# Multi-repo code indexing (repo.search / repo.readFile tools). Repos are
# registered per-tenant via the admin API (POST /api/v1/repos) and synced
# with POST /api/v1/repos/:id/sync.
REPO_WORKDIR=/data/repos
# Comma-separated git hosts the indexer may clone from (egress allowlist).
REPO_GIT_HOST_ALLOWLIST=github.com
# Token for cloning private repos. Passed to git via config env — never in
# a URL, log, or database row. Leave empty for public-only indexing.
# GITHUB_TOKEN=
# GitHub organization whose repos can be bulk-imported via
# GET /api/v1/repos/discover and POST /api/v1/repos/import.
# GITHUB_ORG=Enflite
# GITHUB_API_BASE=https://api.github.com
# Local-path repo registrations are confined to this root.
# REPO_LOCAL_ROOT=/data/repos-local
# REPO_CHUNK_OVERLAP=300
# REPO_MAX_FILE_BYTES=524288
# REPO_MAX_CHUNKS_PER_REPO=20000

# Observability
# /metrics is public unless NODE_ENV=production; set true explicitly to expose it in prod (scrape over a private network).
# METRICS_PUBLIC=
# Per-dependency timeout (ms) for the /ready checks.
# READY_CHECK_TIMEOUT_MS=2000
