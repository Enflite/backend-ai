# Runtime
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://app_user:change-me@localhost:5432/enflite_ai
CORS_ORIGIN=http://localhost:8443

# Authentication (replace with secret-manager values)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECURE=false
DEV_AUTH_ENABLED=false

# Approved OpenAI-compatible internal inference
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=internal-model-registry-default
VLLM_API_KEY=
AI_PROVIDER_ALLOWED_ORIGINS=http://localhost:8000,http://vllm:8000
AI_REQUEST_TIMEOUT_MS=120000

# Internal embeddings
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_MODEL=internal-embedding-model
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# S3-compatible private object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=enflite-ai-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=26214400

# Internal document security services
DOCUMENT_EXTRACTOR_ENDPOINT=http://localhost:8090/extract
MALWARE_SCANNER_ENDPOINT=http://localhost:8091/scan
MALWARE_SCAN_REQUIRED=false

# Optional internal SyteLine adapter
SYTELINE_BASE_URL=https://syteline.internal.example
SYTELINE_API_TOKEN=
