# Runtime
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://app_user:change-me@localhost:5432/enflite_ai
CORS_ORIGIN=http://localhost:8443

# Authentication (replace with secret-manager values)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECURE=false
DEV_AUTH_ENABLED=false

# Approved OpenAI-compatible internal inference
VLLM_API_KEY=
AI_PROVIDER_ALLOWED_ORIGINS=http://localhost:8000,http://vllm:8000
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RESPONSE_CHARS=65536
AI_MAX_TOOL_ITERATIONS=5
AI_TOOL_OUTPUT_MAX_CHARS=8000

# Internal embeddings
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_MODEL=internal-embedding-model
EMBEDDING_MODEL_VERSION=1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# S3-compatible private object storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=enflite-ai-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MAX_UPLOAD_BYTES=26214400
MAX_EXTRACTED_CHARACTERS=2000000
MAX_ARCHIVE_ENTRIES=1000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=52428800
MAX_DOCUMENT_CHUNKS=2000
EMBEDDING_BATCH_SIZE=32
RAG_TOP_K_MAX=20
MAX_RAG_CONTEXT_CHARACTERS=24000
# Minimum blended vector+lexical score for a chunk to enter model context.
# 0 disables the floor (default).
RAG_SIMILARITY_THRESHOLD=0

# Internal document security services
MALWARE_SCANNER_ENDPOINT=http://localhost:8091/scan
# disabled-development never reports a file clean and is forbidden in production.
MALWARE_SCAN_MODE=disabled-development

# Optional internal SyteLine adapter
SYTELINE_BASE_URL=https://syteline.internal.example
SYTELINE_API_TOKEN=
# Per-request timeout (ms) for SyteLine adapter calls; sits inside AI_TOOL_TIMEOUT_MS.
# SYTELINE_TIMEOUT_MS=15000
# Row cap for list fields in SyteLine results (order lines, POs, work orders,
# BOM components, inventory transactions); longer lists are truncated with a marker.
# SYTELINE_MAX_ROWS=100

# Observability
# /metrics is public unless NODE_ENV=production; set true explicitly to expose it in prod (scrape over a private network).
# METRICS_PUBLIC=
# Per-dependency timeout (ms) for the /ready checks.
# READY_CHECK_TIMEOUT_MS=2000
